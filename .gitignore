# Rust build output
/target

# User-local display settings (written at runtime by the Settings screen)
/settings.ron

# mdbook build output
/book

# Web bundle (game + storybook + book) for GitHub Pages
/dist
# Trunk per-app build output (crates/<bin>/dist/)
dist/

# JetBrains IDEs (IntelliJ, CLion, RustRover, etc.)
# Ignore the entire IDE project directory — it holds user-specific and
# machine-specific state that should not be shared.
/.idea/
# Module files (can also live outside .idea/)
*.iml
*.ipr
*.iws
# JetBrains "Project Structure" / build output dirs
/out/
/.idea_modules/
# Editor-based REST client scratch files
**/httpRequests/
# CMake (CLion)
/cmake-build-*/
